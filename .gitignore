# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# build output (per-workspace; e.g. apps/web/.next, apps/api/dist)
**/.next/
**/dist/
**/out/
**/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env (any nested .env or .env.local) — but keep the .env.example templates
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# vercel
.vercel

# playwright (e2e artefacts, regenerated per run)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# typescript
*.tsbuildinfo
**/next-env.d.ts

# Claude Code — personal/local approval cache & state (never commit).
# The shared .claude/settings.json and .claude/commands/ ARE committed.
.claude/settings.local.json
