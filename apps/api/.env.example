# Copy to .env and fill in. Required vars are validated at boot by config/env.schema.ts.

# Required —————————————————————————————————————————————————————

# Must match apps/web's AUTH_JWT_SECRET. Generate: `openssl rand -base64 32`
AUTH_JWT_SECRET=

# MongoDB connection string (Atlas or local). app talks to Mongo via Mongoose only.
MONGODB_URI=mongodb://localhost:27017/educatio

# Web origin allowed by CORS (single value; no trailing slash).
WEB_ORIGIN=http://localhost:3000

# Optional in dev —————————————————————————————————————————————

PORT=3001
NODE_ENV=development

# Fastify trustProxy hop count (or CIDR/IP list) for deriving client IP from
# X-Forwarded-For. Must match your proxy depth; never "true" in prod. Default 1.
# TRUST_PROXY=1

# Off by default; uncomment only on portfolio/demo deploys.
# ENABLE_DEMO_LOGIN=true

# Feature-specific (uncomment as the matching feature module lands)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@educatio.app

# Canvas rooms. Secret key (sk_) from liveblocks.io/dashboard/apikeys — never the
# public pk_ key. Unset is fine: /liveblocks/auth answers 503, nothing else breaks.
LIVEBLOCKS_SECRET_KEY=

# AI lesson summary. Free key from aistudio.google.com/apikey — no card needed.
# Unset is fine: /lessons/:id/summary answers 503, the rest still works.
# NOTE: Google's free tier trains on submitted content; use a paid tier for real
# student data.
GOOGLE_GENERATIVE_AI_API_KEY=

# Canvas image uploads. vercel.com → Storage → create a Blob store → the token
# (vercel_blob_rw_). Unset is fine: /upload answers 503, the rest still works.
BLOB_READ_WRITE_TOKEN=
# SENTRY_DSN=
