# Copy to .env.local and fill in.

# Must match apps/api's AUTH_JWT_SECRET (proxy.ts verifies the session JWT with it).
# Generate: `openssl rand -base64 32`
AUTH_JWT_SECRET=

# Base URL of the api service.
EDUCATIO_API_URL=http://localhost:3001

# Liveblocks client publishable key (safe to ship to the browser).
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=

# Sentry (optional in dev)
SENTRY_DSN=
